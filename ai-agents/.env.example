# Bahmni / OpenMRS REST (same host as Bahmni; used to enrich SOAP / differential context)
BAHMNI_BASE_URL=http://localhost:8080
BAHMNI_USERNAME=superman
BAHMNI_PASSWORD=Admin123

# LLM — set GOOGLE_API_KEY from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=
# If a model 404s in your region, try: gemini-1.5-flash or gemini-1.5-flash-8b
GEMINI_MODEL=gemini-2.0-flash

# Optional fallbacks
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=

# Whisper: local (faster-whisper) or openai (needs OPENAI_API_KEY)
# For local mode + browser recordings (webm): install ffmpeg — macOS: brew install ffmpeg
WHISPER_MODE=local
WHISPER_MODEL_SIZE=base

# Agent DB — leave unset to use SQLite file ai_agents_local.db in this folder (no Postgres required)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_agents

PORT=8001

# Optional: POST AI alerts into OpenMRS as observations
AI_CLINICAL_ALERT_CONCEPT_UUID=
